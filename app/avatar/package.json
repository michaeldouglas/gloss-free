{
  "name": "libras-avatar",
  "version": "0.1.0",
  "private": true,
  "description": "Base web e desktop para o avatar 3D da dissertação de Libras.",
  "type": "commonjs",
  "main": "dist-electron/electron/main/main.js",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:8080 && npm run build:electron && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:8080 electron .\"",
    "build:web": "tsc -p tsconfig.app.json && vite build",
    "build:electron": "tsc -p tsconfig.electron.json --noEmit false",
    "build": "npm run build:web && npm run build:electron",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:desktop": "npm run build && electron-builder"
  },
  "dependencies": {
    "@pixiv/three-vrm": "3.5.5",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "cross-env": "10.1.0",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wait-on": "9.5.1"
  },
  "build": {
    "appId": "br.dissertacao.libras.avatar",
    "productName": "Libras Avatar",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
