{
  "description": "Project-local Bun/TypeScript hooks for Graphify and Spec Kit guardrails.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bun run hooks/session-start.ts",
            "statusMessage": "Loading harness conventions",
            "additionalContextLimit": 1800,
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bun run hooks/project-venv-policy.ts",
            "statusMessage": "Checking application Python environment",
            "additionalContextLimit": 700,
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun run hooks/user-prompt-context.ts",
            "statusMessage": "Checking repository context",
            "additionalContextLimit": 600,
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun run hooks/pre-tool-policy.ts",
            "statusMessage": "Checking harness policy",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bun run hooks/project-venv-policy.ts",
            "statusMessage": "Checking application Python environment",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun run hooks/pre-tool-policy.ts",
            "statusMessage": "Checking edited paths",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun run hooks/post-tool-use.ts",
            "statusMessage": "Refreshing canonical Graphify",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
